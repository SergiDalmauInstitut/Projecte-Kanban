<Window x:Class="ProjecteKanban.FinestraEditarTasca"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ProjecteKanban"
        mc:Ignorable="d"
        Title="MainWindow" Height="750" Width="800">
    
    <Window.Resources>

        <!-- TEXTBOX AMB CANTONADES ARRODONIDES -->
        <Style x:Key="RoundedTextBox" TargetType="TextBox">
            <Setter Property="Margin" Value="0 0 0 20"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="BorderBrush" Value="#CCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border CornerRadius="10"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Border Background="#F2F2F2" Padding="30">
        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0">
                <StackPanel Width="350">

                    <TextBlock Text="Nova Tasca"
                               FontSize="28"
                               FontWeight="Bold"
                               Margin="0 0 0 25"/>

                    <!-- NOM -->
                    <TextBlock Text="Nom" FontSize="14" Margin="4 0 0 10"/>
                    <TextBox Text="{Binding Nom}"
                             Style="{StaticResource RoundedTextBox}"/>

                    <!-- DESCRIPCIÓ -->
                    <TextBlock Text="Descripció" FontSize="14" Margin="4 0 0 10"/>
                    <TextBox Text="{Binding Descripcio}"
                             Height="90"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             Style="{StaticResource RoundedTextBox}"/>

                    <!-- ETIQUETES -->
                    <TextBlock Text="Etiquetes" FontSize="14" Margin="4 0 0 10"/>
                    <TextBox Text="{Binding Etiquetes}"
                             Style="{StaticResource RoundedTextBox}"/>

                    <!-- !!! DATEPICKER MANTINGUT EXACTE TAL COM EL TENIES !!! -->

                    <TextBlock Text="Data Començament" FontSize="14" Margin="4 0 0 10"/>
                    <DatePicker Height="25"
                                SelectedDate="{Binding DataInici}"
                                Margin="0 0 0 20">
                        <DatePicker.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="10"></Setter>
                                <Setter Property="Padding" Value="5"></Setter>
                            </Style>
                        </DatePicker.Resources>
                    </DatePicker>

                    <TextBlock Text="Data Finalització" FontSize="14" Margin="4 0 0 10"/>
                    <DatePicker Height="25"
                                SelectedDate="{Binding DataFi}"
                                Margin="0 0 2 20">
                        <DatePicker.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="10"></Setter>
                            </Style>
                        </DatePicker.Resources>
                    </DatePicker>

                </StackPanel>
            </ScrollViewer>

            <Button Grid.Row="1"
                    Width="120"
                    Height="40"
                    HorizontalAlignment="Right"
                    Margin="0 10 0 0"
                    Content="Finalitzar"
                    Background="#4CAF50"
                    Foreground="White"
                    Click="Finalitzar_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="10"/>
                    </Style>
                </Button.Resources>
            </Button>

        </Grid>
    </Border>
</Window>
